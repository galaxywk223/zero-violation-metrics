{
  "algo": "PPOSaute",
  "algo_cfgs": {
    "adv_estimation_method": "gae",
    "batch_size": 64,
    "clip": 0.2,
    "cost_gamma": 0.99,
    "cost_normalize": false,
    "critic_norm_coef": 0.001,
    "entropy_coef": 0.0,
    "gamma": 0.99,
    "kl_early_stop": true,
    "lam": 0.95,
    "lam_c": 0.95,
    "max_ep_len": 1000,
    "max_grad_norm": 40.0,
    "obs_normalize": true,
    "penalty_coef": 0.0,
    "reward_normalize": false,
    "safety_budget": 25.0,
    "saute_gamma": 0.999,
    "standardized_cost_adv": true,
    "standardized_rew_adv": true,
    "steps_per_epoch": 20000,
    "target_kl": 0.02,
    "unsafe_reward": -1.0,
    "update_iters": 40,
    "use_cost": false,
    "use_critic_norm": true,
    "use_max_grad_norm": true
  },
  "env_id": "SafetyPointButton1-v0",
  "exp_increment_cfgs": {
    "train_cfgs": {
      "device": "cpu",
      "parallel": 1,
      "torch_threads": 1,
      "total_steps": 5000000,
      "vector_env_nums": 8
    }
  },
  "exp_name": "PPOSaute-{SafetyPointButton1-v0}",
  "logger_cfgs": {
    "log_dir": "<HOST_PATH>/pposaute",
    "save_model_freq": 250,
    "use_tensorboard": false,
    "use_wandb": false,
    "wandb_project": "omnisafe",
    "window_lens": 100
  },
  "model_cfgs": {
    "actor": {
      "activation": "tanh",
      "hidden_sizes": [
        64,
        64
      ],
      "lr": 0.0003
    },
    "actor_type": "gaussian_learning",
    "critic": {
      "activation": "tanh",
      "hidden_sizes": [
        64,
        64
      ],
      "lr": 0.0003
    },
    "exploration_noise_anneal": false,
    "linear_lr_decay": true,
    "std_range": [
      0.5,
      0.1
    ],
    "weight_initialization_mode": "kaiming_uniform"
  },
  "seed": 2,
  "train_cfgs": {
    "device": "cpu",
    "epochs": 250,
    "parallel": 1,
    "torch_threads": 1,
    "total_steps": 5000000,
    "vector_env_nums": 8
  }
}
